{
	"name": "kitto",
	"version": "1.5.0",
	"description": "A unique blend of tree-shakeable items for any web expedition",
	"keywords": [
		"svelte",
		"utilities"
	],
	"homepage": "https://github.com/mattpilott/kitto#readme",
	"bugs": {
		"url": "https://github.com/mattpilott/kitto/issues"
	},
	"license": "MIT",
	"author": "Matt Pilott",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mattpilott/kitto.git"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"type": "module",
	"sideEffects": [
		"**/*.css"
	],
	"main": "./dist/vanilla/index.js",
	"types": "./dist/vanilla/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/vanilla/index.d.ts",
			"default": "./dist/vanilla/index.js"
		},
		"./vanilla": {
			"types": "./dist/vanilla/index.d.ts",
			"default": "./dist/vanilla/index.js"
		},
		"./svelte": {
			"types": "./dist/svelte/index.d.ts",
			"svelte": "./dist/svelte/index.js",
			"default": "./dist/svelte/index.js"
		},
		"./lightningcss": {
			"types": "./dist/lightningcss/index.d.ts",
			"default": "./dist/lightningcss/index.js"
		},
		"./reset": "./dist/styles/reset.css",
		"./unify": "./dist/styles/unify.css"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"bench": "vitest bench",
		"dev": "vite dev",
		"build": "vite build && npm run prepack",
		"docs": "typedoc",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"coverage": "vitest run --coverage",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright test"
	},
	"devDependencies": {
		"@eslint/compat": "2.1.0",
		"@eslint/js": "10.0.1",
		"@microsoft/api-documenter": "^7.30.7",
		"@microsoft/api-extractor": "^7.58.9",
		"@playwright/test": "1.61.1",
		"@sveltejs/adapter-auto": "7.0.1",
		"@sveltejs/kit": "2.69.1",
		"@sveltejs/package": "2.5.8",
		"@sveltejs/vite-plugin-svelte": "7.1.2",
		"@testing-library/jest-dom": "6.9.1",
		"@testing-library/svelte": "5.4.2",
		"@types/node": "26.1.0",
		"@vitest/coverage-v8": "4.1.10",
		"eslint": "10.6.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.20.0",
		"global-jsdom": "29.0.0",
		"globals": "17.7.0",
		"jsdom": "29.1.1",
		"prettier": "3.9.4",
		"prettier-plugin-svelte": "4.1.1",
		"publint": "0.3.21",
		"svelte": "5.56.4",
		"svelte-check": "4.7.1",
		"tinydate": "1.3.0",
		"typedoc": "0.28.20",
		"typedoc-github-theme": "0.4.0",
		"typescript": "6.0.3",
		"typescript-eslint": "8.62.1",
		"vite": "8.1.3",
		"vitest": "4.1.10"
	},
	"peerDependencies": {
		"lightningcss": "^1",
		"svelte": "^5.56.4"
	}
}
